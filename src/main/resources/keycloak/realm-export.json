{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "ACME staff — cross-tenant access" },
      { "name": "tenant-admin", "description": "Manages their own tenant's users/products/subscription" },
      { "name": "tenant-user", "description": "Read/write access to their own tenant's products" }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "subGroups": [
        {
          "name": "northwind-traders",
          "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] }
        },
        {
          "name": "globex-industries",
          "attributes": { "tenant_id": ["22222222-2222-2222-2222-222222222222"] }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "acme-api",
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "acme-api-secret"
    },
    {
      "clientId": "acme-cli",
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@acme.io",
      "email": "admin@acme.io",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ACME",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["platform-admin"]
    },
    {
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "username": "alice@northwind.example",
